# 复制为 .env 使用；密钥只出现在 .env，绝不入库（已 gitignore）

# RSSHub 基地址（建议自建 Docker 实例；公共实例限流且不稳定）
# 离线调试可指向本地 RSS fixture 目录，如：
#   RSSHUB_BASE_URL=file:///Users/you/content-factory/tests/fixtures
RSSHUB_BASE_URL=https://rsshub.app

# 统一告警出口（第 7 章横切约定）。P-1a 选定 Server酱：
#   NOTIFY_WEBHOOK=https://sctapi.ftqq.com/<SENDKEY>.send
# 留空则告警只写日志。演练：python -m app.services.notify WARN test 通道演练 "验收"
NOTIFY_WEBHOOK=

# 产品内 LLM（P0 起使用，P-1a 不需要）
# OpenAI 兼容协议 + 强制 JSON mode；客户端只依赖下面三个环境变量，供应商切换不改代码。
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_API_KEY=
# MODEL_NAME=deepseek-chat
# 超时(秒，默认 60)、max_tokens 上限(默认 4096)与单价集中 config.py，可按需覆盖：
# CF_LLM_TIMEOUT_SECONDS=60
# CF_LLM_MAX_TOKENS=4096
# 强制走 mock 降级（返回固定 JSON，用于无 Key 跑通链路）：
# CF_LLM_MOCK=1

# 微信公众号（P0 起使用）
# WECHAT_APP_ID=
# WECHAT_SECRET=

# 小红书采样 M2（P-1b；只读搜索，禁止任何写/互动接口）
# xiaohongshu-mcp 以 Docker 跑在本机（xpzouying/xiaohongshu-mcp，Go 独立服务），
# 专用数据小号扫码登录，凭据只进本地 mcp 服务，不进仓库。fans 探针见 docs/p-1b-fans-probe.md
XHS_MCP_BASE_URL=http://localhost:18060
# 可覆盖项：采样间隔小时（默认 6）/ 检索词上限（默认 20）/ 检索词（留空取 domains.yml）/
# 周度拆解调度（默认周一 06:00）/ 低粉爆款与撞题阈值（P4 校准前初值）/ 熔断阈值（默认 3）：
# CF_XHS_SAMPLE_INTERVAL_HOURS=6
# CF_XHS_SAMPLE_MAX_QUERIES=20
# CF_XHS_SAMPLE_KEYWORDS=AI工具,程序员副业
# CF_XHS_TEARDOWN_WEEKDAY=mon
# CF_XHS_TEARDOWN_HOUR=6
# CF_VIRAL_FANS_MAX=5000
# CF_VIRAL_LIKES_MIN=500
# CF_VIRAL_SCORE_MIN=2.0
# CF_TOPIC_DUPLICATE_JACCARD=0.5
# CF_COLLECTOR_CIRCUIT_FAILURES=3

# RedFox（红狐数据 redfox.hk）小红书只读数据源（按调用计费）。
# 配置 Key 即启用：采样优先走 RedFox（搜索结果自带作者粉丝数，低粉爆款判定
# 直接跑通），无 Key 或调用失败自动降级上面的 xiaohongshu-mcp。
# Key 在 redfox.hk 注册后于密钥管理页创建（ak_ 开头），只放 .env 不进仓库。
# CF_REDFOX_API_KEY=ak_xxxxxx
# 可覆盖项：洞察搜索时间窗天数（默认 7）/ 超时秒（默认 180；接口延迟波动大，
# 宁等不弃——掐断在途请求仍计费却拿不到结果。连接建立固定 10s 快败）：
# CF_REDFOX_WINDOW_DAYS=7
# CF_REDFOX_TIMEOUT=180
# 探针（配置 Key 后）：.venv/Scripts/python -m app.collectors.redfox probe "AI工具"

# 运维覆盖项（一般无需修改）
# RUN_SCHEDULER=1
# CF_DB_PATH=/绝对路径/app.db
# CF_BACKUP_DIR=/绝对路径/backups
