# 复制为 .env 使用；密钥只出现在 .env，绝不入库（已 gitignore）

# RSSHub 基地址（建议自建 Docker 实例；公共实例限流且不稳定）
# 离线调试可指向本地 RSS fixture 目录，如：
#   RSSHUB_BASE_URL=file:///Users/you/content-factory/tests/fixtures
RSSHUB_BASE_URL=https://rsshub.app

# 统一告警出口（第 7 章横切约定）。P-1a 选定 Server酱：
#   NOTIFY_WEBHOOK=https://sctapi.ftqq.com/<SENDKEY>.send
# 留空则告警只写日志。演练：python -m app.services.notify WARN test 通道演练 "验收"
NOTIFY_WEBHOOK=

# 产品内 LLM（P0 起使用，P-1a 不需要）
# OpenAI 兼容协议 + 强制 JSON mode；客户端只依赖下面三个环境变量，供应商切换不改代码。
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_API_KEY=
# MODEL_NAME=deepseek-chat
# 超时(秒，默认 60)、max_tokens 上限(默认 4096)与单价集中 config.py，可按需覆盖：
# CF_LLM_TIMEOUT_SECONDS=60
# CF_LLM_MAX_TOKENS=4096
# 强制走 mock 降级（返回固定 JSON，用于无 Key 跑通链路）：
# CF_LLM_MOCK=1

# 微信公众号（P0 起使用）
# WECHAT_APP_ID=
# WECHAT_SECRET=

# 运维覆盖项（一般无需修改）
# RUN_SCHEDULER=1
# CF_DB_PATH=/绝对路径/app.db
# CF_BACKUP_DIR=/绝对路径/backups
