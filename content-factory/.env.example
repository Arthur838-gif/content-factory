# 复制为 .env 使用；密钥只出现在 .env，绝不入库（已 gitignore）

# RSSHub 基地址（建议自建 Docker 实例；公共实例限流且不稳定）
# 离线调试可指向本地 RSS fixture 目录，如：
#   RSSHUB_BASE_URL=file:///Users/you/content-factory/tests/fixtures
RSSHUB_BASE_URL=https://rsshub.app

# 统一告警出口（第 7 章横切约定）。P-1a 选定 Server酱：
#   NOTIFY_WEBHOOK=https://sctapi.ftqq.com/<SENDKEY>.send
# 留空则告警只写日志。演练：python -m app.services.notify WARN test 通道演练 "验收"
NOTIFY_WEBHOOK=

# 产品内 LLM（P0 起使用，P-1a 不需要）
# OpenAI 兼容协议 + 强制 JSON mode。这里只是「回退默认」：日常切换模型请用
# /models 模型配置页（存 model_configs 表，文案/图片各自设「当前使用」，
# 页面切换即刻生效、无需重启）；未设「当前使用」的用途才落到这三个变量。
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_API_KEY=
# MODEL_NAME=deepseek-chat
# 超时(秒，默认 120)、max_tokens 上限(默认 8192)与回退单价集中 config.py，可按需覆盖：
# CF_LLM_TIMEOUT_SECONDS=120
# CF_LLM_MAX_TOKENS=8192
# 强制走 mock 降级（返回固定 JSON，用于无 Key 跑通链路）：
# CF_LLM_MOCK=1

# 封面底图文生图（P2；总闸 + 默认模型，实际调用走 /models 页图片配置）
# CF_IMAGEGEN_ENABLED 总闸默认开；关掉后即使页面配了图片模型也不出图（防误计费）。
# GLM_IMAGE_MODEL 是无「当前使用」图片配置时的 .env 回退模型。
# CF_IMAGEGEN_ENABLED=true
# GLM_IMAGE_MODEL=cogview-4

# 微信公众号（P0 起使用）
# WECHAT_APP_ID=
# WECHAT_SECRET=

# 小红书采样 M2（P-1b；只读搜索，禁止任何写/互动接口）
# 唯一数据源 RedFox（见下）；曾并存的 xiaohongshu-mcp 本地降级源已废弃。
# 可覆盖项：采样间隔小时（默认 6）/ 检索词上限（默认 20）/ 检索词（留空取栏目词池/领域词表）/
# 周度拆解调度（默认周一 06:00）/ 低粉爆款与撞题阈值（P4 校准前初值）/ 熔断阈值（默认 3）：
# CF_XHS_SAMPLE_INTERVAL_HOURS=6
# CF_XHS_SAMPLE_MAX_QUERIES=20
# CF_XHS_SAMPLE_KEYWORDS=AI工具,程序员副业
# CF_XHS_TEARDOWN_WEEKDAY=mon
# CF_XHS_TEARDOWN_HOUR=6
# CF_VIRAL_FANS_MAX=5000
# CF_VIRAL_LIKES_MIN=500
# CF_VIRAL_SCORE_MIN=2.0
# CF_TOPIC_DUPLICATE_JACCARD=0.5
# CF_COLLECTOR_CIRCUIT_FAILURES=3

# 公众号采样 P9（RedFox 优质库 searchArticle，sortType=_4 最热；只读、按调用计费）
# 无粉丝字段 → 爆款判定走阅读量口径：reads ≥ CF_GZH_READS_MIN 且
# 互动密度 ≥ CF_GZH_SCORE_MIN（初值待首轮真实数据校准，口径见 docs/p4-calibration.md）。
# 采样词优先级同 xhs：显式传入 > CF_GZH_SAMPLE_KEYWORDS > 栏目词池 > 领域词表。
# 定时采样仍仅 xhs——公众号只手动触发（计费纪律）。
# CF_GZH_READS_MIN=10000
# CF_GZH_SCORE_MIN=0.08
# CF_GZH_SAMPLE_MAX_QUERIES=20
# CF_GZH_SAMPLE_KEYWORDS=AI工具,大模型

# 发布回填效果分权重（P9 扩展 watches/shares；likes/collects/comments 沿用 P4 初值）
# CF_SCORE_W_WATCHES=1
# CF_SCORE_W_SHARES=3

# RedFox（红狐数据 redfox.hk）只读数据源（按调用计费；小红书七日爆款 + 公众号优质库）。
# 配置 Key 即启用：小红书搜索自带作者粉丝数（低粉爆款判定）；公众号优质库无粉丝字段
# （阅读量口径判定，见上方 P9 注释）。未配 Key 或调用失败时采样任务直接失败（无降级源），
# 计入熔断。Key 在 redfox.hk 注册后于密钥管理页创建（ak_ 开头），只放 .env 不进仓库。
# CF_REDFOX_API_KEY=ak_xxxxxx
# 可覆盖项：洞察搜索时间窗天数（默认 7）/ 超时秒（默认 180；接口延迟波动大，
# 宁等不弃——掐断在途请求仍计费却拿不到结果。连接建立固定 10s 快败）：
# CF_REDFOX_WINDOW_DAYS=7
# CF_REDFOX_TIMEOUT=180
# 探针（配置 Key 后）：.venv/Scripts/python -m app.collectors.redfox probe "AI工具"

# 运维覆盖项（一般无需修改）
# RUN_SCHEDULER=1
# CF_DB_PATH=/绝对路径/app.db
# CF_BACKUP_DIR=/绝对路径/backups
